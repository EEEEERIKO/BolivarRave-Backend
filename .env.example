# Supabase connection strings (replace CHANGE_ME_DB_PASSWORD_URL_ENCODED)
# If your password has special chars, encode it first (example: @ -> %40).
DATABASE_URL="postgresql://postgres:CHANGE_ME_DB_PASSWORD_URL_ENCODED@db.<project-ref>.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:CHANGE_ME_DB_PASSWORD_URL_ENCODED@db.<project-ref>.supabase.co:5432/postgres"

# Backend runtime config
PORT=4000
NODE_ENV=development
AUTH_ACCESS_TOKEN_EXPIRES_IN=1h
AUTH_REFRESH_TOKEN_TTL_DAYS=3650
CORS_ORIGINS="http://localhost:3000,https://administracion-bolivar-rave.vercel.app"
ADMIN_API_KEY="CHANGE_ME_STRONG_RANDOM_KEY"

# Supabase project config
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_ANON_KEY=""

# Private keys (set manually, never commit real values)
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
