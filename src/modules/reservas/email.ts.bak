import { Resend } from "resend";

const resend = new Resend(process.env.RESEND_API_KEY);

export interface ReservationEmailData {
  id: string;
  requesterName: string;
  requesterEmail: string;
  resourceLabel: string;
  resourceType: "rooms" | "equipment";
  bookingDate: string;
  startTime: string;
  endTime: string;
  purpose: string;
  destinationRoom?: string;
  confirmationToken: string;
}

const getConfirmationUrl = (reservationId: string, token: string): string => {
  const baseUrl = process.env.FRONTEND_URL || "http://localhost:3000";
  return `${baseUrl}/reservas/confirm?reservationId=${reservationId}&token=${token}`;
};



const escapeHtml = (value: string): string =>
  value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

const formatReservationType = (resourceType: string): string => {
  return resourceType === "rooms" ? "Salón/Aula" : "Equipo";
};

const buildEmailHtml = (data: ReservationEmailData): string => {
  const confirmUrl = getConfirmationUrl(data.id, data.confirmationToken);
  const resourceType = formatReservationType(data.resourceType);
  const resourceLabel = escapeHtml(data.resourceLabel);
  const requesterName = escapeHtml(data.requesterName);
  const bookingDate = escapeHtml(data.bookingDate);
  const startTime = escapeHtml(data.startTime);
  const endTime = escapeHtml(data.endTime);
  const purpose = escapeHtml(data.purpose);
  const destinationRoom = data.destinationRoom ? escapeHtml(data.destinationRoom) : null;
  const returnWarning = data.resourceType === "equipment"
    ? `Debes devolver el equipo a más tardar a las ${endTime}. Si se daña, falta algún componente o se incumple el horario, puede aplicar una penalización.`
    : `Debes dejar el salón en buen estado y respetar el horario confirmado. El incumplimiento o cualquier daño reportado puede generar una penalización.`;

  return `
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      :root {
        --primary: #1a3a52;
        --secondary: #2d5a7b;
        --accent: #c94c4c;
        --success: #2d7a3a;
        --gray-900: #111827;
        --gray-700: #374151;
        --gray-600: #4b5563;
        --gray-500: #6b7280;
        --gray-300: #d1d5db;
        --gray-200: #e5e7eb;
        --gray-50: #f9fafb;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
        font-size: 14px;
        line-height: 1.6;
        color: var(--gray-900);
        background-color: var(--gray-50);
      }

      .email-wrapper {
        max-width: 640px;
        margin: 0 auto;
        background-color: white;
      }

      .header {
        background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
        color: white;
        padding: 40px 32px;
        text-align: center;
      }

      .header h1 {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.5px;
        margin-bottom: 4px;
      }

      .header p {
        font-size: 13px;
        opacity: 0.95;
        font-weight: 500;
      }

      .success-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        background-color: rgba(255, 255, 255, 0.15);
        border-radius: 50%;
        color: white;
        font-size: 28px;
        margin-bottom: 16px;
        font-weight: 700;
      }

      .content {
        padding: 40px 32px;
      }

      .greeting {
        font-size: 16px;
        color: var(--gray-900);
        margin-bottom: 28px;
        font-weight: 500;
      }

      .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin: 28px 0;
        background-color: var(--gray-50);
        padding: 24px;
        border-radius: 8px;
        border: 1px solid var(--gray-200);
      }

      .detail-item {
        display: flex;
        flex-direction: column;
      }

      .detail-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--gray-500);
        margin-bottom: 6px;
      }

      .detail-value {
        font-size: 15px;
        font-weight: 600;
        color: var(--gray-900);
      }

      .detail-item.full-width {
        grid-column: 1 / -1;
      }

      .terms-box {
        background-color: #fef9f0;
        border-left: 4px solid var(--accent);
        padding: 16px;
        margin: 24px 0;
        border-radius: 4px;
      }

      .terms-box h3 {
        font-size: 14px;
        font-weight: 700;
        color: var(--accent);
        margin-bottom: 8px;
      }

      .terms-box p {
        font-size: 13px;
        color: var(--gray-700);
        margin-bottom: 8px;
      }

      .terms-box p:last-child {
        margin-bottom: 0;
      }

      .action-button {
        display: inline-block;
        background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
        color: white;
        padding: 12px 32px;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        margin: 28px 0;
      }

      .fallback-link {
        background-color: var(--gray-50);
        padding: 16px;
        border-radius: 6px;
        border: 1px solid var(--gray-200);
        margin: 16px 0;
        text-align: center;
      }

      .fallback-link p {
        font-size: 12px;
        color: var(--gray-600);
        margin-bottom: 8px;
      }

      .fallback-link code {
        display: block;
        background-color: white;
        padding: 8px 12px;
        border-radius: 4px;
        word-break: break-all;
        font-size: 11px;
        color: var(--gray-700);
        font-family: 'Courier New', monospace;
      }

      .footer {
        background-color: var(--gray-50);
        border-top: 1px solid var(--gray-200);
        padding: 28px 32px;
        text-align: center;
        font-size: 12px;
        color: var(--gray-600);
      }

      .footer p {
        margin-bottom: 6px;
      }

      .footer p:last-child {
        margin-bottom: 0;
        color: var(--gray-500);
        font-size: 11px;
      }

      .divider {
        height: 1px;
        background-color: var(--gray-200);
        margin: 24px 0;
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="header">
        <div class="success-badge">✓</div>
        <h1>Aceptación de Términos de Reserva</h1>
        <p>Debe aceptar las condiciones para finalizar su reserva</p>
        <p>Administración del Edificio Bolívar</p>
      </div>

      <div class="content">
        <p class="greeting">Estimado/a ${requesterName},</p>
        
        <p>Hemos recibido su solicitud de reserva. Antes de finalizar y activar la reserva, debe revisar y aceptar las condiciones de uso del recurso solicitado.</p>

        <div class="details-grid">
          <div class="detail-item">
            <span class="detail-label">Tipo de Recurso</span>
            <span class="detail-value">${resourceType}</span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Recurso</span>
            <span class="detail-value">${resourceLabel}</span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Fecha</span>
            <span class="detail-value">${bookingDate}</span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Hora Inicio</span>
            <span class="detail-value">${startTime}</span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Hora Fin / Devolución</span>
            <span class="detail-value">${endTime}</span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Propósito</span>
            <span class="detail-value">${purpose}</span>
          </div>
          ${
            destinationRoom
              ? `<div class="detail-item full-width">
            <span class="detail-label">Ubicación de Entrega</span>
            <span class="detail-value">${destinationRoom}</span>
          </div>`
              : ""
          }
        </div>

        <div class="terms-box">
          <h3>⚠ Responsabilidades del Usuario</h3>

          <p>Al confirmar esta reserva, usted acepta:</p>
          <p>• Utilizar el recurso únicamente para el propósito indicado.</p>
          <p>• Mantener el salón/equipo en buen estado durante el periodo de préstamo.</p>
          <p>• Devolver el recurso completo, limpio y en las mismas condiciones en las que fue entregado.</p>
          <p>• Responder por daños, pérdida de componentes, uso indebido o retrasos en la devolución.</p>
          <p>• Cumplir los horarios establecidos por la administración.</p>
          <p>El incumplimiento de estas condiciones puede generar sanciones administrativas, suspensión temporal del servicio o cobros asociados a daños ocasionados.</p>
        </div>

        <div style="text-align: center;">
          <a href="${confirmUrl}" class="action-button">Aceptar Términos y Confirmar Reserva</a>
        </div>

        <div class="fallback-link">
          <p>Si el botón anterior no responde, copie y pegue este enlace en su navegador:</p>
          <code>${confirmUrl}</code>
        </div>

        <p style="font-size: 12px; color: #6b7280; margin-top: 16px;">
          Al hacer clic en “Aceptar Términos y Confirmar Reserva”, usted declara haber leído y aceptado las condiciones de uso y responsabilidad asociadas al préstamo del recurso solicitado.
        </p>

        <div class="divider"></div>

        <p style="font-size: 13px; color: var(--gray-700); margin-bottom: 12px;">
          Si tiene dudas sobre su reserva o necesita hacer cambios, por favor contáctese con el departamento de administración.
        </p>
      </div>

      <div class="footer">
        <p><strong>Corporación Universitaria Adventista de Colombia(UNAC)</strong></p>
        <p>Administración del Edificio Bolívar Rave</p>
        <p>Este es un correo automático. Por favor, no responda a este mensaje.</p>
        <p>&copy; 2026 UNAC. Todos los derechos reservados.</p>
      </div>
    </div>
  </body>
</html>
  `;
};

export const sendReservationConfirmationEmail = async (data: ReservationEmailData): Promise<{ success: boolean; error?: string }> => {
  try {
    if (!data.requesterEmail) {
      console.warn(`No email provided for reservation ${data.id}`);
      return { success: false, error: "No email provided" };
    }

    const html = buildEmailHtml(data);

    const response = await resend.emails.send({
      from: "bolivar-rave-reservas@unac.edu.co",
      to: data.requesterEmail,
      subject: `Acción Requerida - Confirmar Reserva de ${data.resourceLabel}`,
      html,
    });

    if (response.error) {
      console.error(`Failed to send email for reservation ${data.id}:`, response.error);
      return { success: false, error: response.error.message };
    }

    console.log(`Email sent successfully for reservation ${data.id}`);
    return { success: true };
  } catch (error) {
    console.error(`Error sending email for reservation ${data.id}:`, error);
    return { success: false, error: error instanceof Error ? error.message : "Unknown error" };
  }
};
